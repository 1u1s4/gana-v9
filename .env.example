AGENT_PROVIDER=codex
OPENROUTER_API_KEY=
AGENT_MODEL=gpt-5.5
AGENT_FAST_MODE=false
AGENT_REASONING_EFFORT=
AGENT_NATIVE_WEB_SEARCH=true
AGENT_NATIVE_WEB_SEARCH_MODE=live
AGENT_BROWSER_FALLBACK=true
BROWSER_USE_API_KEY=
BROWSER_USE_BASE_URL=https://api.browser-use.com
BROWSER_USE_MODEL=
BROWSER_USE_MAX_TASKS_PER_MONTH=10
BROWSER_USE_MAX_CONCURRENT_SESSIONS=3
BROWSER_USE_TIMEOUT_MS=180000
AGENT_MAX_STEPS=20
AGENT_MAX_COST=1
CODEX_HOME=
CODEX_MODEL_LIST_PATH=config/codex-models.json

# Gana runtime
GANA_RUNTIME=mvp-productivo-online
GANA_PROFILE=standard
GANA_APPROVAL_MODE=manual
GANA_ARTIFACT_ROOT=.artifacts/gana-v9

# Discord routing. If a flow target is empty, wrappers fall back to GANA_DISCORD_TARGET
# and then to the historical operational channel.
GANA_DISCORD_TARGET=
GANA_DISCORD_RECOMMENDATIONS_TARGET=discord:CHANNEL_ID
GANA_DISCORD_VALIDATION_TARGET=discord:CHANNEL_ID
GANA_DISCORD_STRATEGY_TARGET=discord:CHANNEL_ID
GANA_DISCORD_ALERTS_TARGET=discord:CHANNEL_ID
GANA_DISCORD_MAX_SELECTIONS=14

# Sports provider skeleton. Leave empty until API-Football is configured.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Canonical runtime database: PostgreSQL/Supabase through the SESSION pooler.
# Keep the password URL-encoded. Do not use the transaction pooler with Prisma.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@SESSION_POOLER_HOST:5432/postgres?sslmode=require&schema=gana_ops&connection_limit=5

# Prisma migrations prefer the direct endpoint when it is reachable. If the direct
# endpoint is unavailable from this network, use the same SESSION pooler URL here.
DIRECT_URL=postgresql://postgres:PASSWORD_URL_ENCODED@DIRECT_DB_HOST:5432/postgres?sslmode=require&schema=gana_ops

# MySQL -> Supabase migration only. Remove these two variables after cutover.
# TARGET_DATABASE_URL is a libpq URL; schema selection belongs in --target-schema,
# so do not append Prisma-only `schema` or `connection_limit` parameters here.
SOURCE_DATABASE_URL=mysql://USER:PASSWORD_URL_ENCODED@SOURCE_HOST:SOURCE_PORT/gana_v9_ops_20260425?sslaccept=accept_invalid_certs
TARGET_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@SESSION_POOLER_HOST:5432/postgres?sslmode=require

# PostgreSQL/Supabase bounded retention. The command is dry-run unless --apply is explicit.
# Voluminous provider/odds rows: hard minimum and default 7 days.
GANA_RAW_RETENTION_DAYS=7
# Transient scans/scrapes: 7 days; research/validation: 14 days.
GANA_TRANSIENT_RETENTION_DAYS=7
GANA_RESEARCH_RETENTION_DAYS=14
# Non-published operational analytics: 30 days; durable ledger/metrics: 60 days.
GANA_ANALYTIC_RETENTION_DAYS=30
GANA_HISTORY_RETENTION_DAYS=60
GANA_RAW_RETENTION_BATCH_SIZE=1000
GANA_RAW_RETENTION_STATEMENT_TIMEOUT_MS=30000
GANA_RAW_RETENTION_LOCK_TIMEOUT_MS=2000
GANA_RAW_RETENTION_MAX_BATCHES=10000

# Default filters used by status commands and future scans.
GANA_DEFAULT_SEASON=
GANA_DEFAULT_MARKETS=h2h,double_chance,goals_over_under,corners_over_under,btts
GANA_LOW_ODDS_THRESHOLD=1.2
GANA_KICKOFF_WINDOW_HOURS=24
GANA_INCLUDE_LIVE_FIXTURES=false
GANA_INCLUDE_COMPLETED_FIXTURES=false
GANA_MAX_FIXTURES_PER_RUN=10000
GANA_MAX_PROVIDER_REQUESTS_PER_RUN=500
GANA_MAX_AGENTIC_RESEARCH_CALLS_PER_RUN=80

# Cron flow overrides.
GANA_DAILY_PROVIDERS=codex
GANA_DAILY_CODEX_MODEL=gpt-5.6-terra
GANA_DAILY_REASONING_EFFORT=high
GANA_DAILY_FAST_MODE=false
GANA_DAILY_CODEX_FALLBACK_MODELS=
GANA_MAINTENANCE_PAUSED=false
GANA_DAILY_PUBLISH_EXISTING=false
GANA_DAILY_PUBLISH_EXISTING_MAX_AGE_HOURS=36
GANA_DAILY_PROVIDER_CONCURRENCY=1
GANA_WEB_MODE=live
GANA_PARLAY_PROFILE=portfolio-v2
GANA_METRICS_PERSIST=true
GANA_STRATEGY_REVIEW_MODEL=gpt-5.6-terra
GANA_STRATEGY_REVIEW_REASONING_EFFORT=high
GANA_STRATEGY_REVIEW_FAST_MODE=false
GANA_STRATEGY_REVIEW_CODEX_FALLBACK_MODELS=
GANA_STRATEGY_REVIEW_CODEX_SANDBOX=read-only
