{
  "name": "gana-agent-tui",
  "version": "0.1.0",
  "description": "Custom terminal UI for OpenRouter-powered coding agents.",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc --rootDir src",
    "prepack": "npm run build",
    "gana": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "tsx src/cli.ts db status",
    "dashboard": "tsx src/cli.ts dashboard",
    "assets:backfill": "tsx scripts/backfill-api-football-assets.ts",
    "update:codex-models": "tsx scripts/update-codex-models.ts",
    "docs:check-notion-source": "node scripts/check-notion-operational-source.mjs",
    "public:ledger": "node scripts/check-public-recommendation-ledger.mjs"
  },
  "keywords": [
    "agent",
    "tui",
    "openrouter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@openrouter/agent": "^0.4.0",
    "@prisma/client": "^6.18.0",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "fast-check": "^4.7.0",
    "prisma": "^6.18.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
