{
  "type": "object",
  "additionalProperties": false,
  "required": ["predictions", "warnings", "metadata"],
  "properties": {
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "oddsQuoteId",
          "market",
          "selection",
          "line",
          "odds",
          "probability",
          "confidence",
          "evidenceIds",
          "claimIds",
          "rationale",
          "warnings"
        ],
        "properties": {
          "oddsQuoteId": { "type": "string", "minLength": 1 },
          "market": {
            "type": "string",
            "enum": ["h2h", "double_chance", "goals_over_under", "corners_over_under", "btts"]
          },
          "selection": { "type": "string", "minLength": 1 },
          "line": { "type": ["number", "null"] },
          "odds": { "type": "number", "exclusiveMinimum": 1 },
          "probability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "claimIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 },
          "warnings": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    }
  }
}
