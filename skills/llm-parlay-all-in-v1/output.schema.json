  "type": "object",
  "properties": {
    "parlays": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "predictionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "riskNotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["title", "predictionIds", "rationale", "riskNotes"]
      }
    },
    "noParlayReason": {
      "type": "string"
    }
  },
  "required": ["parlays"]
}
